# Generic Benchy installer

# To install into a chroot, set $DESTDIR to the corresponding directory.

die() {
	printf '%s\n' "$1" >&2
	exit "${2:-1}"
}

if [ "X$1" = "X" ]
then
	INSTALL_PREFIX="/usr"
else
	INSTALL_PREFIX="$1"
fi

# Ensure the user is in the correct directory
if [ ! -f pts-core/phoronix-test-suite.php ]
then
	die '
	To install Benchy you must first change directories to benchy/. For support visit: http://www.phoronix-test-suite.com/
'
fi

# The launcher's PTS_DIR line is rewritten below, found by its marker. Check that before anything is removed or copied.
MARKERS=$(grep -cF '# install-sh:pts-dir' benchy)
if [ "$MARKERS" != 1 ]
then
	die "ERROR: install_macos expected exactly one '# install-sh:pts-dir' marker line in the benchy launcher and found $MARKERS. The installed launcher would not work."
fi

mkdir -p "$DESTDIR$INSTALL_PREFIX"
if [ ! -w "$DESTDIR$INSTALL_PREFIX" ]
then
	die "ERROR: $DESTDIR$INSTALL_PREFIX is not writable. Run this installer as root or specify a different directory prefix as the first argument sent to this script."
fi

rm -rf "$DESTDIR$INSTALL_PREFIX"/share/benchy/
rm -rf "$DESTDIR$INSTALL_PREFIX"/share/doc/benchy/

mkdir -p "$DESTDIR$INSTALL_PREFIX"/bin/
mkdir -p "$DESTDIR$INSTALL_PREFIX"/share/applications/
mkdir -p "$DESTDIR$INSTALL_PREFIX"/share/icons/hicolor/48x48/apps/
mkdir -p "$DESTDIR$INSTALL_PREFIX"/share/man/man1/
mkdir -p "$DESTDIR$INSTALL_PREFIX"/share/benchy/
mkdir -p "$DESTDIR$INSTALL_PREFIX"/share/doc/benchy/
mkdir -p "$DESTDIR$INSTALL_PREFIX"/../etc/bash_completion.d/
#mkdir -p $DESTDIR$INSTALL_PREFIX/../usr/lib/systemd/system/
#mkdir -p $DESTDIR$INSTALL_PREFIX/../etc/init/

cp ChangeLog "$DESTDIR$INSTALL_PREFIX"/share/doc/benchy/
cp COPYING "$DESTDIR$INSTALL_PREFIX"/share/doc/benchy/
cp AUTHORS "$DESTDIR$INSTALL_PREFIX"/share/doc/benchy/

cd documentation/ || exit
cp -r * "$DESTDIR$INSTALL_PREFIX"/share/doc/benchy/
cd ..
rm -rf "$DESTDIR$INSTALL_PREFIX"/share/doc/benchy/man-pages/

cp documentation/man-pages/*.1 "$DESTDIR$INSTALL_PREFIX"/share/man/man1/
cp pts-core/static/bash_completion "$DESTDIR$INSTALL_PREFIX"/../etc/bash_completion.d/benchy
cp pts-core/static/images/benchy.png "$DESTDIR$INSTALL_PREFIX"/share/icons/hicolor/48x48/apps/benchy.png
cp pts-core/static/benchy.desktop "$DESTDIR$INSTALL_PREFIX"/share/applications/
cp pts-core/static/benchy-launcher.desktop "$DESTDIR$INSTALL_PREFIX"/share/applications/

mkdir -p "$DESTDIR$INSTALL_PREFIX"/../usr/lib/systemd/system/
cp deploy/*-systemd/*.service "$DESTDIR$INSTALL_PREFIX"/../usr/lib/systemd/system/

# mkdir -p $DESTDIR$INSTALL_PREFIX/../etc/init/
# cp pts-core/static/upstart/*.conf $DESTDIR$INSTALL_PREFIX/../etc/init/

rm -rf "$DESTDIR$INSTALL_PREFIX"/share/benchy/pts-core
cp -r pts-core "$DESTDIR$INSTALL_PREFIX"/share/benchy/
cp -r ob-cache "$DESTDIR$INSTALL_PREFIX"/share/benchy/
cp -r deploy "$DESTDIR$INSTALL_PREFIX"/share/benchy/
rm -f "$DESTDIR$INSTALL_PREFIX"/share/benchy/pts-core/static/benchy.desktop
rm -f "$DESTDIR$INSTALL_PREFIX"/share/benchy/pts-core/static/benchy-launcher.desktop
rm -f "$DESTDIR$INSTALL_PREFIX"/share/benchy/pts-core/openbenchmarking.org/openbenchmarking-mime.xml
rm -f "$DESTDIR$INSTALL_PREFIX"/share/benchy/pts-core/static/bash_completion
rm -f "$DESTDIR$INSTALL_PREFIX"/share/benchy/pts-core/static/images/openbenchmarking.png
rm -f "$DESTDIR$INSTALL_PREFIX"/share/benchy/pts-core/static/images/%benchy.png


# Point the installed launcher at the installed copy. The line is found by its marker comment, not by its exact text, so editing the
# launcher's own code can't silently break this. The rewrite goes to a temp file next to the real one and is only moved into place
# once the rewritten line is in it. (The launcher's PTS_DIR block has macOS branches ahead of this line, so unlike install-sh this
# can't run the block to see what it resolves to.)
PTS_DIR_ESC=$(printf '%s' "$INSTALL_PREFIX" | sed 's/[\\&|]/\\&/g')
LAUNCHER_TMP=$(mktemp "$DESTDIR$INSTALL_PREFIX"/bin/.benchy.XXXXXX) || die "ERROR: install_macos could not create a temporary file in $DESTDIR$INSTALL_PREFIX/bin/."
sed 's|^\([[:space:]]*\).*# install-sh:pts-dir.*$|\1export PTS_DIR='"$PTS_DIR_ESC"'/share/benchy|' benchy > "$LAUNCHER_TMP"
if [ "$(grep -cF "export PTS_DIR=$INSTALL_PREFIX/share/benchy" "$LAUNCHER_TMP")" != 1 ]
then
	rm -f "$LAUNCHER_TMP"
	die "ERROR: install_macos could not point $DESTDIR$INSTALL_PREFIX/bin/benchy at $INSTALL_PREFIX/share/benchy. The installed launcher would not work."
fi
chmod 755 "$LAUNCHER_TMP" && mv -f "$LAUNCHER_TMP" "$DESTDIR$INSTALL_PREFIX"/bin/benchy || { rm -f "$LAUNCHER_TMP"; die "ERROR: install_macos could not put the launcher in place at $DESTDIR$INSTALL_PREFIX/bin/benchy."; }

# sed 's:\$url = PTS_PATH . \"documentation\/index.html\";:\$url = \"'"$INSTALL_PREFIX"'\/share\/doc\/packages\/benchy\/index.html\";:g' pts-core/commands/gui_gtk.php > $DESTDIR$INSTALL_PREFIX/share/benchy/pts-core/commands/gui_gtk.php

# XDG MIME OpenBenchmarking support
if [ "X$DESTDIR" = "X" ] && which xdg-mime >/dev/null && which xdg-icon-resource >/dev/null
then
	#No chroot
	xdg-mime install pts-core/openbenchmarking.org/openbenchmarking-mime.xml
	xdg-icon-resource install --context mimetypes --size 64 pts-core/static/images/openbenchmarking.png application-x-openbenchmarking
else
	#chroot
	mkdir -p "$DESTDIR$INSTALL_PREFIX"/share/mime/packages/
	mkdir -p "$DESTDIR$INSTALL_PREFIX"/share/icons/hicolor/64x64/mimetypes/
	cp pts-core/openbenchmarking.org/openbenchmarking-mime.xml "$DESTDIR$INSTALL_PREFIX"/share/mime/packages/
	cp pts-core/static/images/openbenchmarking.png "$DESTDIR$INSTALL_PREFIX"/share/icons/hicolor/64x64/mimetypes/application-x-openbenchmarking.png

fi

printf '%b\n' "\nBenchy Installation Completed\n
Executable File: $INSTALL_PREFIX/bin/benchy
Documentation: $INSTALL_PREFIX/share/doc/benchy/
Benchy Files: $INSTALL_PREFIX/share/benchy/\n"

if [ "X$DESTDIR" != "X" ]
then
	echo "Installed to chroot: $DESTDIR"
	echo "Please update your desktop and mime-database manually"
fi
