[Unit]
Description=Benchy server update (installs the signed update a server administrator asked for)
Documentation=https://github.com/dakotlyar/benchy
StartLimitIntervalSec=60
# (a request that cannot be taken would start this over and over; refusals end cleanly, so only a stuck request reaches the limit)
StartLimitBurst=20

[Service]
Type=oneshot
ExecStart=/usr/bin/php -n /usr/lib/benchy/benchy-server-update
StandardInput=null
Environment=DEBIAN_FRONTEND=noninteractive
UMask=0022
PrivateTmp=yes
TimeoutStartSec=30min
