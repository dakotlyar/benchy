#!/bin/sh
# benchy-server: the service user, its folders, and a restart onto the new code if the server is running. Needs no network and asks nothing.
set -e

SVC_USER=phoromatic
SVC_HOME=/var/lib/phoromatic
USER_OK=1

case "$1" in
configure)
	if getent passwd "$SVC_USER" >/dev/null 2>&1
	then
		# An existing user (for example one made by hand from the admin guide) is left as it is; only say so if it will not work
		home=$(getent passwd "$SVC_USER" | cut -d: -f6)
		uid=$(getent passwd "$SVC_USER" | cut -d: -f3)
		uid_min=$(sed -n 's/^UID_MIN[[:space:]]*\([0-9]*\).*/\1/p' /etc/login.defs 2>/dev/null | head -n 1)
		if [ "$home" != "$SVC_HOME" ]
		then
			echo "benchy-server: WARNING: the existing user $SVC_USER has the home directory $home, not $SVC_HOME. Nothing was changed; benchy-server-setup will refuse until this is sorted out." >&2
			USER_OK=0
		elif [ "$uid" -ge "${uid_min:-1000}" ]
		then
			echo "benchy-server: WARNING: the existing user $SVC_USER is not a system account (uid $uid). Nothing was changed; benchy-server-setup will refuse until this is sorted out." >&2
			USER_OK=0
		fi
	else
		adduser --system --group --no-create-home --home "$SVC_HOME" --shell /usr/sbin/nologin "$SVC_USER"
	fi

	# Folders only when missing, and never a recursive chown of an existing tree
	if [ "$(getent passwd "$SVC_USER" | cut -d: -f6)" = "$SVC_HOME" ]
	then
		for dir in "$SVC_HOME" "$SVC_HOME/storage"
		do
			if [ ! -d "$dir" ]
			then
				install -d -o "$SVC_USER" -g "$SVC_USER" -m 0750 "$dir"
			fi
		done
	fi

	if [ -d /run/systemd/system ]
	then
		systemctl daemon-reload || true
		# Moves a running server onto the new code: on an upgrade, and on the first install of this package over a server that was
		# set up by hand. A server that is stopped stays stopped (so "stop, back up, upgrade, start" still works), a reinstall of the
		# same version touches nothing, and the first install on a fresh machine starts nothing. On the first install a running server
		# is only restarted when it already runs as the phoromatic user: a 0.9.7 stock unit runs as root with the data in /var/lib/benchy,
		# and restarting that under the new drop-in would bring up an empty server with open registration.
		this_version=$(dpkg-query -W -f='${Version}' benchy-server 2>/dev/null || true)
		if [ -z "$2" ] || [ "$2" != "$this_version" ]
		then
			restart=1
			if [ "$USER_OK" != 1 ]
			then
				restart=0
			elif [ -z "$2" ] && case "$(systemctl show -p ActiveState --value phoromatic-server.service 2>/dev/null)" in active|activating|reloading) true;; *) false;; esac
			then
				# the owner of the running process: the unit's User= already shows the new drop-in after the daemon-reload above
				main_pid=$(systemctl show -p MainPID --value phoromatic-server.service 2>/dev/null || true)
				running_user=
				if [ -n "$main_pid" ] && [ "$main_pid" != 0 ] && [ -d "/proc/$main_pid" ]
				then
					running_user=$(stat -c %U "/proc/$main_pid" 2>/dev/null || true)
				fi
				if [ "$running_user" != "$SVC_USER" ]
				then
					restart=0
					echo "benchy-server: phoromatic-server is running as ${running_user:-an unknown user} (or is restarting by itself), not as $SVC_USER, so it was NOT restarted. It will come up as $SVC_USER with an EMPTY database the next time it restarts or the machine reboots. Stop and disable it now (sudo systemctl disable --now phoromatic-server), then run: sudo benchy-server-setup" >&2
				fi
			fi
			if [ "$restart" = 1 ]
			then
				if [ -x /usr/bin/deb-systemd-invoke ]
				then
					deb-systemd-invoke try-restart phoromatic-server.service >/dev/null || true
				else
					systemctl try-restart phoromatic-server.service || true
				fi
			fi
		fi
	fi

	if [ -z "$2" ] && ! systemctl is-enabled phoromatic-server.service >/dev/null 2>&1
	then
		echo "benchy-server: installed. Next: sudo benchy-server-setup --names HOST,IP --admin-user NAME --admin-email ADDRESS"
	fi
	;;
abort-upgrade|abort-remove|abort-deconfigure)
	;;
*)
	echo "postinst called with unknown argument '$1'" >&2
	exit 1
	;;
esac

exit 0
