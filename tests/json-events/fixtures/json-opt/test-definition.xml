<?xml version="1.0"?>
<PhoronixTestSuite>
  <TestInformation>
    <Title>JSON Options</Title>
    <AppVersion>1.0</AppVersion>
    <Description>JSON mode test fixture.</Description>
    <ResultScale>Points</ResultScale>
    <Proportion>HIB</Proportion>
    <TimesToRun>2</TimesToRun>
  </TestInformation>
  <TestProfile>
    <Version>1.0.0</Version>
    <SupportedPlatforms>Linux, Windows</SupportedPlatforms>
    <SoftwareType>Benchmark</SoftwareType>
    <TestType>System</TestType>
    <License>Free</License>
    <Status>Verified</Status>
    <EnvironmentSize>1</EnvironmentSize>
    <ProjectURL>https://example.invalid/</ProjectURL>
    <Maintainer>QC</Maintainer>
  </TestProfile>
  <TestSettings>
    <Option>
      <DisplayName>Mode</DisplayName>
      <Identifier>mode</Identifier>
      <ArgumentPrefix>--mode=</ArgumentPrefix>
      <DefaultEntry>2</DefaultEntry>
      <Menu>
        <Entry><Name>Fast</Name><Value>1</Value><Message>quick</Message></Entry>
        <Entry><Name>Slow</Name><Value>2</Value></Entry>
      </Menu>
    </Option>
    <Option>
      <DisplayName>Level</DisplayName>
      <Identifier>level</Identifier>
      <ArgumentPrefix>--level=</ArgumentPrefix>
      <Menu>
        <Entry><Name>3</Name><Value>3</Value></Entry>
        <Entry><Name>5</Name><Value>5</Value></Entry>
      </Menu>
    </Option>
  </TestSettings>
</PhoronixTestSuite>
